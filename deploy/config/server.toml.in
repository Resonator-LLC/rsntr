# resonator@@DOMAIN@: the official server for name@@DOMAIN@.
domain = "@DOMAIN@"
listen = ["127.0.0.1:@PORT@"]
database_path = "/var/lib/resonator/@DOMAIN@/resonator.db"
registration_enabled = true
other_servers = [@OTHERS@]
trusted_proxies = ["127.0.0.1", "::1"]
cookie_secure = "always"

[federation]
enabled = true
mode = "open"
relay = "https://rly.rsntr.net"
listen = "0.0.0.0:@FEDPORT@"

[push]
relay = "https://psh.rsntr.net"

# Wave apps run here for every account of the domain: a cap that fits the
# droplet (each instance up to its manifest's memory_mb, 64 by default).
[apps]
enabled = true
max_instances = 16

# Wave app media (microphone, camera, what apps send back) between browsers
# and this server over WebRTC, on one UDP port; browsers that cannot reach
# it keep using the client socket.
[webrtc]
enabled = true
listen = "0.0.0.0:@RTCPORT@"
advertise = "@PUBLIC_IP@:@RTCPORT@"
