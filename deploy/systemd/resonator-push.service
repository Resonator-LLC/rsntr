[Unit]
Description=Resonator push relay
After=network-online.target
Wants=network-online.target

[Service]
User=resonator-push
Group=resonator-push
EnvironmentFile=/etc/resonator-push/env
ExecStart=/usr/local/bin/resonator-push --config /etc/resonator-push/relay.toml
Restart=always
RestartSec=2
Environment=RUST_LOG=info
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
